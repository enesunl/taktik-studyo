# Build-time browser configuration: public values only. Empty = bundled offline catalogue.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
TURNSTILE_SITE_KEY=

# Local matches QA uses the existing SUPABASE_URL/public key for read-only Auth
# verification. The browser calls /__local/matches only on loopback port 4173.
# Supply BSD_API_TOKEN in the server process environment; never a browser define.
# Example variable name only (no token value is stored here): BSD_API_TOKEN

# Explicit local server catalogue mode. Production/static builds stay legacy.
# Set in the process running: node scripts/serve-local.cjs 4173
# Allowed values: legacy | canonical
# canonical uses clean persistent .local/catalogue-d4 PGlite, not linked Supabase writes.
CATALOGUE_SOURCE=legacy

# Build-time browser configuration: public values only. There is no bundled offline roster
# (SEC1.1): without a Supabase target, roster pages show an explicit "unavailable" state.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
TURNSTILE_SITE_KEY=
# Optional. Default canonical = BSD catalogue (catalogue_* tables). legacy = explicit rollback build only.
# CATALOGUE_SOURCE=canonical

# LOCAL DEVELOPMENT: serve-local.cjs deliberately DOES NOT read .env.
# It obtains local URL/public key from `supabase status -o json` and verifies
# loopback Auth health before listening. No production fallback.
# Use ignored .env.local (or the server process environment) only for:
# CATALOGUE_SOURCE=canonical  (default; existing local PGlite source)
# CATALOGUE_TRANSPORT=supabase (optional; read the imported catalogue from Supabase Local tables)
# Catalogue import (scripts/catalogue/import.mjs) reads keys from the operator shell only:
#   local: from `supabase status`; hosted: CATALOGUE_IMPORT_SECRET_KEY + SUPABASE_URL (never in any file)
# BSD_API_TOKEN=             (server-only; optional for live match data)
# Do not copy production SUPABASE_URL/key into .env.local.
# Do not put service-role/secret keys into browser config or any tracked file.

# Build-time browser configuration: public values only. Empty = bundled offline catalogue.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
TURNSTILE_SITE_KEY=

# LOCAL DEVELOPMENT: serve-local.cjs deliberately DOES NOT read .env.
# It obtains local URL/public key from `supabase status -o json` and verifies
# loopback Auth health before listening. No production fallback.
# Use ignored .env.local (or the server process environment) only for:
# CATALOGUE_SOURCE=canonical  (default; existing local PGlite source)
# BSD_API_TOKEN=             (server-only; optional for live match data)
# Do not copy production SUPABASE_URL/key into .env.local.
# Do not put service-role/secret keys into browser config or any tracked file.
